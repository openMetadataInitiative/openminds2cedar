# CEDAR Workbench API Configuration
# ==================================
# Copy this file to .env and fill in your actual values

# CEDAR API Key
# Get your API key from: https://cedar.metadatacenter.org/profile
# Click on "Show API Key" in your profile
CEDAR_API_KEY=your-api-key-here

# Optional: Override config.yaml settings
# CEDAR_BASE_URL=https://resource.metadatacenter.org
# CEDAR_FOLDER_ID=https://repo.metadatacenter.org/folders/your-folder-id

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
