# CEDAR API Key (required)
# Get from: https://cedar.metadatacenter.org/profile
CEDAR_API_KEY=your-api-key-here

# CEDAR folder IDs (required)
CEDAR_FOLDER_ELEMENTS=https://repo.metadatacenter.org/folders/your-elements-folder-id
CEDAR_FOLDER_TEMPLATES=https://repo.metadatacenter.org/folders/your-templates-folder-id
CEDAR_FOLDER_INSTANCES=https://repo.metadatacenter.org/folders/your-instances-folder-id
